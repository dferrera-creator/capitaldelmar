generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id              String    @id @default(cuid())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  name            String
  email           String
  phone           String?
  country         String?
  projectSlug     String?
  amountApprox    Int?      // in MXN
  termMonths      Int?
  isQualified     Boolean   @default(false)
  score           Int       @default(0)
  source          String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmContent      String?
  utmTerm         String?
  hubspotId       String?
  privacyAccepted Boolean   @default(false)
  step            Int       @default(1)
  status          LeadStatus @default(NEW)
  SimulatorRun    SimulatorRun[]
  DataRoomAccess  DataRoomAccess[]
  Consent         Consent[]
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  MEETING_SCHEDULED
  INVESTED
  REJECTED
}

model Project {
  id              String    @id @default(cuid())
  slug            String    @unique
  name            String
  tagline         String?
  location        String
  assetType       AssetType
  status          ProjectStatus @default(OPEN)
  returnRate      Decimal?  @db.Decimal(5,2)
  returnType      ReturnType?
  returnNote      String?
  minTicket       Int?      // in MXN
  termMonths      Int?
  availableSlots  Int?
  totalSlots      Int?
  imageUrl        String?
  benefits        Json      // array of strings
  protections     Json      // array of strings
  risks           Json      // array of strings
  displayOrder    Int       @default(0)
  publishedAt     DateTime?
  Document        Document[]
}

enum AssetType {
  LAND
  HOTEL_PARTICIPATION
  BUSINESS_SHARES
  MANAGEMENT_FLOW
  HOTEL_TRADE
}

enum ProjectStatus {
  OPEN
  CLOSED
  COMING_SOON
  FULLY_FUNDED
}

enum ReturnType {
  FIXED
  ESTIMATED
  HISTORICAL
}

model Document {
  id              String    @id @default(cuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id])
  name            String
  description     String?
  fileKey         String    // S3 key
  requiresAuth    Boolean   @default(true)
  requiresNDA     Boolean   @default(false)
  mimeType        String?
  sizeBytes       Int?
  DataRoomAccess  DataRoomAccess[]
}

model DataRoomRequest {
  id              String    @id @default(cuid())
  createdAt       DateTime  @default(now())
  email           String
  name            String
  company         String?
  message         String?
  status          DataRoomRequestStatus @default(PENDING)
  ndaSigned       Boolean   @default(false)
  approvedAt      DateTime?
  rejectedAt      DateTime?
}

enum DataRoomRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model DataRoomAccess {
  id              String    @id @default(cuid())
  accessedAt      DateTime  @default(now())
  leadId          String?
  lead            Lead?     @relation(fields: [leadId], references: [id])
  documentId      String
  document        Document  @relation(fields: [documentId], references: [id])
  userEmail       String
  ipAddress       String?
  userAgent       String?
}

model SimulatorRun {
  id              String    @id @default(cuid())
  createdAt       DateTime  @default(now())
  leadId          String?
  lead            Lead?     @relation(fields: [leadId], references: [id])
  email           String
  amount          Int
  termMonths      Int
  projectSlug     String?
  scenarioBear    Json
  scenarioBase    Json
  scenarioBull    Json
  emailSent       Boolean   @default(false)
}

model Consent {
  id              String    @id @default(cuid())
  createdAt       DateTime  @default(now())
  leadId          String?
  lead            Lead?     @relation(fields: [leadId], references: [id])
  email           String
  type            ConsentType
  accepted        Boolean
  ipAddress       String?
  userAgent       String?
}

enum ConsentType {
  PRIVACY_POLICY
  TERMS
  MARKETING
  COOKIES_ANALYTICS
  COOKIES_MARKETING
  INVESTOR_DECLARATION
}

model CetesRate {
  id              String    @id @default(cuid())
  fetchedAt       DateTime  @default(now())
  rate            Decimal   @db.Decimal(5,4)
  term            String    // "28d", "91d", "182d", "364d"
  source          String    @default("banxico")
  validUntil      DateTime?
}
